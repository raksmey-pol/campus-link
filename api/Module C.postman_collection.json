        {
          "name": "User A — Cooldown check (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "const res = pm.response.json();",
                  "pm.test('Cooldown error', () => pm.expect(res.message).to.include('wait until'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/swaps",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"swap_type\": \"SECTION\",\n  \"current_course_id\": 2,\n  \"current_section\": \"A\",\n  \"desired_section\": \"B\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "8 — Admin",
      "item": [
        {
          "name": "Admin — Force delete swap",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/swaps/{{swap_id_b}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }]
          }
        },
        {
          "name": "Non-admin delete (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/swaps/{{swap_id_b}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        }
      ]
    },
    {
      "name": "9 — Chain Match Flow",
      "item": [
        {
          "name": "User A — Swap course 3 section A → B",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('swap_id_a', res.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/swaps",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"swap_type\": \"SECTION\",\n  \"current_course_id\": 3,\n  \"current_section\": \"A\",\n  \"desired_section\": \"B\"\n}"
            }
          }
        },
        {
          "name": "User B — Swap course 3 section B → C",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('swap_id_b', res.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/swaps",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_b}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"swap_type\": \"SECTION\",\n  \"current_course_id\": 3,\n  \"current_section\": \"B\",\n  \"desired_section\": \"C\"\n}"
            }
          }
        },
        {
          "name": "User C — Swap course 3 section C → A (triggers chain match)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('swap_id_c', res.data.id);",
                  "pm.test('Status OPEN or MATCHED', () => pm.expect(['OPEN','MATCHED']).to.include(res.data.status));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/swaps",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_c}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"swap_type\": \"SECTION\",\n  \"current_course_id\": 3,\n  \"current_section\": \"C\",\n  \"desired_section\": \"A\"\n}"
            }
          }
        },
        {
          "name": "Verify chain match created — all 3 requests MATCHED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has matches', () => pm.expect(res.data.length).to.be.above(0));",
                  "if (res.data.length > 0) {",
                  "  pm.collectionVariables.set('match_id', res.data[0].id);",
                  "  pm.test('Match type CHAIN', () => pm.expect(res.data[0].match_type).to.eql('CHAIN'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/matches",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        },
        {
          "name": "User A — Confirm chain match",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/swaps/matches/{{match_id}}/confirm",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        },
        {
          "name": "User B — Confirm chain match",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/swaps/matches/{{match_id}}/confirm",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }]
          }
        },
        {
          "name": "User C — Confirm chain match (completes 3-way swap)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/swaps/matches/{{match_id}}/confirm",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_c}}" }]
          }
        },
        {
          "name": "Verify chain match COMPLETED with requestC",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Status COMPLETED', () => pm.expect(res.data.status).to.eql('COMPLETED'));",
                  "pm.test('Has requestC', () => pm.expect(res.data.requestC).to.exist);",
                  "pm.test('3 confirmations', () => pm.expect(res.data.confirmations.length).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/matches/{{match_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        }
      ]
    }
  ]
