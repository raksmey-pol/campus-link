{
  "info": {
    "name": "CampusLink — Module C: Course Swap",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token_a", "value": "" },
    { "key": "token_b", "value": "" },
    { "key": "token_c", "value": "" },
    { "key": "swap_id_a", "value": "" },
    { "key": "swap_id_b", "value": "" },
    { "key": "swap_id_c", "value": "" },
    { "key": "match_id", "value": "" }
  ],
  "item": [
    {
      "name": "0 — Auth",
      "item": [
        {
          "name": "Login User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('token_a', res.data.access_token);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has access_token', () => pm.expect(res.data.access_token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"user_a@test.com\", \"password\": \"password123\" }"
            }
          }
        },
        {
          "name": "Login User B",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('token_b', res.data.access_token);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"user_b@test.com\", \"password\": \"password123\" }"
            }
          }
        },
        {
          "name": "Login User C (chain match)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('token_c', res.data.access_token);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"user_c@test.com\", \"password\": \"password123\" }"
            }
          }
        }
      ]
    },
    {
      "name": "1 — Swap Requests (Public)",
      "item": [
        {
          "name": "List open swaps (no auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(res.data).to.be.an('array'));",
                  "pm.test('Has meta', () => pm.expect(res.meta).to.have.property('total'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/swaps",
              "query": []
            }
          }
        },
        {
          "name": "List swaps — filter by course_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/swaps?course_id=1",
              "query": [
                { "key": "course_id", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "List swaps — filter by type SECTION",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/swaps?type=SECTION",
              "query": [
                { "key": "type", "value": "SECTION" }
              ]
            }
          }
        },
        {
          "name": "Get swap by ID (not found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/99999"
          }
        }
      ]
    },
    {
      "name": "2 — Create Swap Requests",
      "item": [
        {
          "name": "User A — Create SECTION swap (course 1, A→B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('swap_id_a', res.data.id);",
                  "pm.test('Status is OPEN', () => pm.expect(res.data.status).to.eql('OPEN'));",
                  "pm.test('Has expires_at', () => pm.expect(res.data.expires_at).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/swaps",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"swap_type\": \"SECTION\",\n  \"current_course_id\": 1,\n  \"current_section\": \"A\",\n  \"desired_section\": \"B\",\n  \"notes\": \"I prefer morning sessions\"\n}"
            }
          }
        },
        {
          "name": "User A — Duplicate active swap (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "const res = pm.response.json();",
                  "pm.test('Correct error message', () => pm.expect(res.message).to.include('already have an active swap'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/swaps",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"swap_type\": \"SECTION\",\n  \"current_course_id\": 1,\n  \"current_section\": \"A\",\n  \"desired_section\": \"C\"\n}"
            }
          }
        },
        {
          "name": "User A — No auth (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/swaps",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"swap_type\": \"SECTION\",\n  \"current_course_id\": 1,\n  \"current_section\": \"A\",\n  \"desired_section\": \"B\"\n}"
            }
          }
        },
        {
          "name": "User A — Invalid course (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/swaps",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"swap_type\": \"SECTION\",\n  \"current_course_id\": 99999,\n  \"current_section\": \"A\",\n  \"desired_section\": \"B\"\n}"
            }
          }
        },
        {
          "name": "User A — COURSE swap missing desired_course_id (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/swaps",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"swap_type\": \"COURSE\",\n  \"current_course_id\": 2\n}"
            }
          }
        },
        {
          "name": "User B — Create SECTION swap (course 1, B→A) — triggers direct match",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('swap_id_b', res.data.id);",
                  "pm.test('Status is OPEN or MATCHED', () => pm.expect(['OPEN','MATCHED']).to.include(res.data.status));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/swaps",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_b}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"swap_type\": \"SECTION\",\n  \"current_course_id\": 1,\n  \"current_section\": \"B\",\n  \"desired_section\": \"A\",\n  \"notes\": \"Prefer afternoon\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3 — My Swaps & Detail",
      "item": [
        {
          "name": "User A — List my swaps",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has at least 1 swap', () => pm.expect(res.data.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/mine",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        },
        {
          "name": "Get swap A by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Correct ID', () => pm.expect(res.data.id).to.eql(parseInt(pm.collectionVariables.get('swap_id_a'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/{{swap_id_a}}"
          }
        }
      ]
    },
    {
      "name": "4 — Matches",
      "item": [
        {
          "name": "User A — List my matches",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "if (res.data.length > 0) {",
                  "  pm.collectionVariables.set('match_id', res.data[0].id);",
                  "  pm.test('Match is PROPOSED', () => pm.expect(res.data[0].status).to.eql('PROPOSED'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/matches",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        },
        {
          "name": "Get match by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has confirmations array', () => pm.expect(res.data.confirmations).to.be.an('array'));",
                  "pm.test('Has requestA', () => pm.expect(res.data.requestA).to.exist);",
                  "pm.test('Has requestB', () => pm.expect(res.data.requestB).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/matches/{{match_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        },
        {
          "name": "Non-participant access match (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/matches/{{match_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_c}}" }]
          }
        },
        {
          "name": "Match not found (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/matches/99999",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        }
      ]
    },
    {
      "name": "5 — Confirmation Flow",
      "item": [
        {
          "name": "User A — Confirm match",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Match confirmed message', () => pm.expect(res.message).to.eql('Match confirmed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/swaps/matches/{{match_id}}/confirm",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        },
        {
          "name": "User A — Confirm again (expect 400 idempotency)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "const res = pm.response.json();",
                  "pm.test('Already confirmed error', () => pm.expect(res.message).to.include('already confirmed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/swaps/matches/{{match_id}}/confirm",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        },
        {
          "name": "User B — Confirm match (completes swap)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Match confirmed', () => pm.expect(res.message).to.eql('Match confirmed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/swaps/matches/{{match_id}}/confirm",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }]
          }
        },
        {
          "name": "Verify match is COMPLETED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Match status COMPLETED', () => pm.expect(res.data.status).to.eql('COMPLETED'));",
                  "pm.test('Both confirmations present', () => pm.expect(res.data.confirmations.length).to.eql(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/matches/{{match_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        },
        {
          "name": "Verify swap requests are COMPLETED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Swap status COMPLETED', () => pm.expect(res.data.status).to.eql('COMPLETED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/swaps/{{swap_id_a}}"
          }
        },
        {
          "name": "Verify points awarded to User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('civic_points increased', () => pm.expect(res.data.civic_points).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }]
          }
        }
      ]
    },
