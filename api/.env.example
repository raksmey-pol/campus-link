# App
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=campuslink
DB_SYNC=false
DB_MIGRATIONS_RUN=false

# Auth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN_SECONDS=604800
JWT_REFRESH_SECRET=replace-with-a-different-strong-secret
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# Optional local seed values (pnpm run db:seed:users)
SEED_DEFAULT_PASSWORD=ChangeMe123!
SEED_ADMIN_EMAIL=admin@campuslink.local
SEED_ADMIN_NAME=Campus Admin
SEED_ADMIN_PASSWORD=
SEED_USER1_EMAIL=user1@campuslink.local
SEED_USER1_NAME=Campus User One
SEED_USER1_PASSWORD=
SEED_USER2_EMAIL=user2@campuslink.local
SEED_USER2_NAME=Campus User Two
SEED_USER2_PASSWORD=

# Storage
# Supported: local | s3
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# S3 (used when STORAGE_DRIVER=s3)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Telegram announcements (Lost & Found)
# 1) Create a bot with @BotFather and copy the bot token
# 2) Add the bot as an admin in your Telegram channel
# 3) Use @channel_username or numeric chat id for TELEGRAM_CHANNEL_ID
# 4) If item photos are local paths (e.g. /uploads/...), set API_PUBLIC_BASE_URL
#    to a public URL reachable by Telegram (example: https://api.your-domain.com)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
API_PUBLIC_BASE_URL=

# Lost & Found submission anti-abuse limits (POST /items)
# Values are positive integers. Window values are in seconds.
ITEMS_SUBMIT_GUEST_BURST_LIMIT=3
ITEMS_SUBMIT_GUEST_BURST_WINDOW_SEC=600
ITEMS_SUBMIT_GUEST_DAILY_LIMIT=15
ITEMS_SUBMIT_GUEST_DAILY_WINDOW_SEC=86400

ITEMS_SUBMIT_AUTH_BURST_LIMIT=10
ITEMS_SUBMIT_AUTH_BURST_WINDOW_SEC=600
ITEMS_SUBMIT_AUTH_DAILY_LIMIT=120
ITEMS_SUBMIT_AUTH_DAILY_WINDOW_SEC=86400
